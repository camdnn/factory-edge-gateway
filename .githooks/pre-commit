#!/usr/bin/env bash
# Enabled per clone with: git config core.hooksPath .githooks
# Checks the staged snapshot in a scratch copy, so unstaged edits neither block nor rescue a commit.
set -euo pipefail
dir=$(mktemp -d)
trap 'rm -rf "$dir"' EXIT
git checkout-index --all --prefix="$dir/"
"$dir/scripts/check.sh"
